{
  "name": "relay-routing",
  "private": true,
  "version": "0.1.0",
  "description": "Relay Routing — local-first multi-provider AI workspace for macOS",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "typecheck": "tsc --noEmit",
    "lint:rust": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings",
    "verify:ollama": "node scripts/verify-ollama.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.4",
    "@tauri-apps/plugin-dialog": "2.8.4",
    "highlight.js": "11.12.0",
    "lucide-react": "1.70.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "rehype-highlight": "7.0.2",
    "remark-gfm": "4.0.1",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.4",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "esbuild": "^0.28.2",
    "jsdom": "31.0.0",
    "typescript": "5.9.3",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  }
}
